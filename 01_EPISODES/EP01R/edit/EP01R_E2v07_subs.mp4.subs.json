[
 {
  "t0": 3.0,
  "t1": 5.05,
  "text": "오빠, 짐 언제 옮겨."
 },
 {
  "t0": 3.3,
  "t1": 5.15,
  "text": "신혼집 인테리어 3개월째. 준호 짐은 아직 창고방"
 },
 {
  "t0": 5.15,
  "t1": 7.920000000000001,
  "text": "옮길 거야. 인테리어 끝나면."
 },
 {
  "t0": 8.02,
  "t1": 10.889999999999999,
  "text": "그 말 세 번째야. Seriously."
 },
 {
  "t0": 10.909999999999998,
  "t1": 13.02,
  "text": "내 짐은 다 들어갔어."
 },
 {
  "t0": 13.29,
  "t1": 16.279999999999998,
  "text": "거기 아직 공사 중이잖아."
 },
 {
  "t0": 16.38,
  "t1": 19.11,
  "text": "주방만. 안방은 끝났어."
 },
 {
  "t0": 19.13,
  "t1": 20.81,
  "text": "오빠가 안 가 봐서 몰라."
 },
 {
  "t0": 21.21,
  "t1": 25.95,
  "text": "(영어로, 빠르게)"
 },
 {
  "t0": 26.16,
  "t1": 29.16,
  "text": "잠깐만. 다시. 천천히. 이거에 대고."
 },
 {
  "t0": 29.490000000000002,
  "t1": 32.49,
  "text": "No. 번역하면 덜 화난 것처럼 들려."
 },
 {
  "t0": 32.72,
  "t1": 33.51,
  "text": "아니 그게 아니고 내 말은 그러니까 짐이라는 게"
 },
 {
  "t0": 33.53,
  "t1": 37.410000000000004,
  "text": "옮긴다고 바로 옮겨지는 게 아니라 공사 먼지 있을 때 들어가면 다시 닦아야 되는 거고—"
 },
 {
  "t0": 37.51,
  "t1": 40.51,
  "text": "응? 뭐라고? 오빠 지금 일부러 빨리 말하지."
 },
 {
  "t0": 40.86,
  "t1": 43.86,
  "text": "너도 아까 일부러 빨리 말했잖아."
 },
 {
  "t0": 46.99,
  "t1": 49.900000000000006,
  "text": "둘이 뭐 해."
 },
 {
  "t0": 50.63,
  "t1": 52.449999999999996,
  "text": "할머니~ 저녁 드셨어요?"
 },
 {
  "t0": 52.47,
  "t1": 55.0,
  "text": "지난번 무말랭이 너무 맛있어서 제가 혼자 다 먹었어요."
 },
 {
  "t0": 55.45,
  "t1": 58.36000000000001,
  "text": "그래서 하나 더 가져왔지."
 },
 {
  "t0": 60.660000000000004,
  "t1": 63.660000000000004,
  "text": "준호 너는. 복 받은 줄 알아라."
 },
 {
  "t0": 72.93,
  "t1": 75.9,
  "text": "번역기로 싸우니까 존댓말로 싸우네."
 },
 {
  "t0": 76.0,
  "t1": 79.03,
  "text": "준호야. 짐은 좀 옮겨라."
 },
 {
  "t0": 79.05,
  "t1": 80.77,
  "text": "리아 말이 맞다."
 },
 {
  "t0": 80.87,
  "t1": 83.62,
  "text": "할머니, 그걸 어떻게……"
 },
 {
  "t0": 83.72,
  "t1": 85.81,
  "text": "내가 다 안다."
 },
 {
  "t0": 85.91,
  "t1": 88.9,
  "text": "할머니 영어 못 하시는데… 어떻게 알았지?"
 },
 {
  "t0": 89.03,
  "t1": 90.71000000000001,
  "text": "벽이 얇아."
 },
 {
  "t0": 92.00999999999999,
  "t1": 94.21,
  "text": "번역기로 싸워 본 적 있나요?"
 }
]