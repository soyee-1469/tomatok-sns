[
 {
  "t0": 3.3,
  "t1": 7.0,
  "text": "여자친구 가족방 인사말, 여섯 번째 고치는 중"
 },
 {
  "t0": 7.0,
  "t1": 9.85,
  "text": "오빠, still? 그거 아직도 써?"
 },
 {
  "t0": 9.95,
  "t1": 12.879999999999999,
  "text": "인사가 제일 중요해. 첫인상이잖아."
 },
 {
  "t0": 12.98,
  "t1": 15.17,
  "text": "읽는 사람은 삼 초야."
 },
 {
  "t0": 18.77,
  "t1": 21.54,
  "text": "다 읽었는데 아무도 말을 안 해."
 },
 {
  "t0": 21.64,
  "t1": 23.93,
  "text": "읽었잖아."
 },
 {
  "t0": 24.03,
  "t1": 27.03,
  "text": "우리 집도 그래. 읽기만 해."
 },
 {
  "t0": 27.42,
  "t1": 30.21,
  "text": "그럼 대답은요?"
 },
 {
  "t0": 30.310000000000002,
  "t1": 33.31,
  "text": "엄마가 전화로 해. 새벽 네 시에."
 },
 {
  "t0": 41.69,
  "t1": 43.47,
  "text": "……그건 뭐야."
 },
 {
  "t0": 44.47,
  "t1": 46.88,
  "text": "아, 이거? 다른 방."
 },
 {
  "t0": 46.98,
  "t1": 49.81,
  "text": "가족방은 지금 조용하잖아."
 },
 {
  "t0": 49.91,
  "t1": 52.48,
  "text": "그 가족방 말고."
 },
 {
  "t0": 56.47,
  "t1": 58.39,
  "text": "오빠 빼고."
 },
 {
  "t0": 63.12,
  "t1": 65.16,
  "text": "지금 내 표정을 보고한 거야?"
 },
 {
  "t0": 65.25999999999999,
  "t1": 68.85,
  "text": "웃고 있다고 했어. 인사도 잘했대."
 },
 {
  "t0": 68.86999999999999,
  "t1": 70.25999999999999,
  "text": "이모지 cute하대."
 },
 {
  "t0": 70.55,
  "t1": 72.53999999999999,
  "text": "그걸 거기서 얘기하면 어떡해."
 },
 {
  "t0": 72.55999999999999,
  "t1": 74.34,
  "text": "내가 있는 방에서 해야지."
 },
 {
  "t0": 74.44,
  "t1": 77.23,
  "text": "여기서는 못하지. 오빠가 있잖아."
 },
 {
  "t0": 79.83,
  "t1": 82.8,
  "text": "……반가우시대."
 },
 {
  "t0": 83.19999999999999,
  "t1": 85.39999999999999,
  "text": "당신 나라에도 '나 빼고 만든 방'이 있나요?"
 }
]