[
 {
  "t0": 7.3,
  "t1": 11.0,
  "text": "여자친구 가족방 인사말, 여섯 번째 고치는 중"
 },
 {
  "t0": 11.0,
  "t1": 13.85,
  "text": "오빠, still? 그거 아직도 써?"
 },
 {
  "t0": 14.0,
  "t1": 16.93,
  "text": "인사가 제일 중요해. 첫인상이잖아."
 },
 {
  "t0": 17.0,
  "t1": 19.189999999999998,
  "text": "읽는 사람은 삼 초야."
 },
 {
  "t0": 22.9,
  "t1": 25.669999999999998,
  "text": "다 읽었는데 아무도 말을 안 해."
 },
 {
  "t0": 25.9,
  "t1": 28.06,
  "text": "읽었잖아."
 },
 {
  "t0": 28.099999999999998,
  "t1": 31.06,
  "text": "우리 집도 그래. 읽기만 해."
 },
 {
  "t0": 31.099999999999998,
  "t1": 33.26,
  "text": "그럼 대답은요?"
 },
 {
  "t0": 33.3,
  "t1": 36.26,
  "text": "엄마가 전화로 해. 새벽 네 시에."
 },
 {
  "t0": 45.35,
  "t1": 46.76,
  "text": "……그건 뭐야."
 },
 {
  "t0": 46.8,
  "t1": 49.21,
  "text": "아, 이거? 다른 방."
 },
 {
  "t0": 49.8,
  "t1": 52.63,
  "text": "가족방은 지금 조용하잖아."
 },
 {
  "t0": 52.8,
  "t1": 54.96,
  "text": "그 가족방 말고."
 },
 {
  "t0": 58.0,
  "t1": 60.07,
  "text": "오빠 빼고."
 },
 {
  "t0": 65.52999999999999,
  "t1": 66.75999999999999,
  "text": "지금 내 표정을 보고한 거야?"
 },
 {
  "t0": 66.8,
  "t1": 69.99,
  "text": "웃고 있다고 했어. 인사도 잘했대."
 },
 {
  "t0": 70.00999999999999,
  "t1": 71.63,
  "text": "이모지 cute하대."
 },
 {
  "t0": 71.8,
  "t1": 74.14999999999999,
  "text": "그걸 거기서 얘기하면 어떡해."
 },
 {
  "t0": 74.16999999999999,
  "t1": 75.96,
  "text": "내가 있는 방에서 해야지."
 },
 {
  "t0": 76.0,
  "t1": 78.95,
  "text": "여기서는 못하지. 오빠가 있잖아."
 },
 {
  "t0": 81.5,
  "t1": 84.46,
  "text": "……반가우시대."
 },
 {
  "t0": 84.8,
  "t1": 87.0,
  "text": "당신 나라에도 '나 빼고 만든 방'이 있나요?"
 }
]