[
 {
  "t0": 0,
  "t1": 3.2,
  "text": "우리는 엄마, 아빠, 나, 동생 네 명이야. 들어왔지?"
 },
 {
  "t0": 3.0,
  "t1": 5.91,
  "text": "응, 오빠도 가족방에 초대했어."
 },
 {
  "t0": 6.3,
  "t1": 8.0,
  "text": "여자친구 가족방에 초대된 지 40초"
 },
 {
  "t0": 8.0,
  "t1": 10.41,
  "text": "들어갔어?"
 },
 {
  "t0": 10.4,
  "t1": 13.45,
  "text": "응… 가족이 엄청 많네."
 },
 {
  "t0": 13.4,
  "t1": 16.01,
  "text": "그런데 계속 누가 들어오는데?"
 },
 {
  "t0": 16.4,
  "t1": 18.229999999999997,
  "text": "…더 빨라졌는데?"
 },
 {
  "t0": 24.4,
  "t1": 26.729999999999997,
  "text": "그동안 어떻게 참으셨지?"
 },
 {
  "t0": 27.4,
  "t1": 30.49,
  "text": "아 진짜… 질문 많이 하지 말라 그랬는데."
 },
 {
  "t0": 30.4,
  "t1": 32.61,
  "text": "…또 들어왔어."
 },
 {
  "t0": 32.01,
  "t1": 34.75,
  "text": "어? 우리 엄마~"
 },
 {
  "t0": 36.11,
  "t1": 39.6,
  "text": "질문 제일 많이 하신 분이 어머님 아니셨어?"
 },
 {
  "t0": 39.4,
  "t1": 42.550000000000004,
  "text": "응. 지금까진 이모랑 사촌이었어."
 },
 {
  "t0": 42.4,
  "t1": 46.19,
  "text": "한 분씩 인사드리려면 하루 걸리겠는걸."
 },
 {
  "t0": 46.4,
  "t1": 49.31,
  "text": "그래도 바로 번역돼서 다행이다~"
 }
]